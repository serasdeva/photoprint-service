PORT=3000
# Интерфейс, на котором слушает приложение. На VPS за nginx — 127.0.0.1;
# пустое значение означает все интерфейсы (удобно для проверки с телефона в локальной сети).
HOST=
NODE_ENV=development
SESSION_SECRET=replace_with_a_secure_secret
JWT_SECRET=replace_with_a_secure_secret
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me_strong_password
ADMIN_EMAIL=admin@photoprint.local
BASE_URL=http://localhost:3000
CORS_ORIGINS=
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USER=noreply@example.com
MAIL_PASS=your-password
MAIL_TO=manager@photoprint.local

# Telegram bot
BOT_ENABLED=false
BOT_TOKEN=
BOT_USERNAME=
BOT_ADMIN_CHAT_ID=

# Monitoring (deploy/healthcheck.sh), optional overrides
HEALTHCHECK_URL=
ALERT_CHAT_ID=
