<%- include('./partials/header', { activePage: 'services', title: service.title, description: service.description }) %>

<main id="main">
  <section class="page-hero service-detail-hero">
    <div class="container">
      <nav class="breadcrumbs" aria-label="Хлебные крошки">
        <a href="/">Главная</a>
        <i class="fa-solid fa-chevron-right"></i>
        <a href="/services">Услуги</a>
        <i class="fa-solid fa-chevron-right"></i>
        <span><%= service.title %></span>
      </nav>
      <h1><%= service.title %></h1>
      <div class="meta-row service-detail-price">
        <span class="price-tag"><%= service.price %> ₽</span>
        <span class="price-unit">/ <%= service.priceUnit %></span>
      </div>
    </div>
  </section>

  <section class="section service-detail-section">
    <div class="container contact-grid service-detail-grid">
      <div class="card reveal service-detail-card">
        <div class="service-media service-detail-media">
          <img src="<%= service.image || '/gallery-placeholders/service-default.svg' %>" alt="<%= service.title %>"<% if (service.width && service.height) { %> width="<%= service.width %>" height="<%= service.height %>"<% } %> />
          <span class="service-icon"><i class="fa <%= service.icon || 'fa-print' %>"></i></span>
        </div>
        <p class="text-muted service-detail-description"><%= service.description %></p>
        <ul class="contact-list">
          <li>
            <i class="fa-solid fa-clock"></i>
            <div>
              <strong>Сроки</strong>
              <span>Обсудим срок выполнения до подтверждения заказа</span>
            </div>
          </li>
          <li>
            <i class="fa-solid fa-circle-check"></i>
            <div>
              <strong>Контроль качества</strong>
              <span>Уточним требования и проверим готовый заказ перед выдачей</span>
            </div>
          </li>
          <li>
            <i class="fa-solid fa-shield-halved"></i>
            <div>
              <strong>Оплата</strong>
              <span>Способы оплаты можно уточнить при оформлении заказа</span>
            </div>
          </li>
        </ul>
      </div>

      <div class="card reveal service-order-card">
        <h3>Оставить заявку</h3>
        <p class="text-muted service-order-copy">Заполните форму — свяжемся с вами и уточним детали заказа.</p>
        <form data-form="order" novalidate>
          <div class="hp-field" aria-hidden="true">
            <input type="text" name="website" tabindex="-1" autocomplete="off" value="" />
          </div>
          <div class="form-grid">
            <div>
              <label for="single-name">Имя <span class="req">*</span></label>
              <input id="single-name" name="name" required placeholder="Ваше имя" autocomplete="name" aria-describedby="single-name-error" />
              <span class="field-error" id="single-name-error" aria-live="polite"></span>
            </div>
            <div>
              <label for="single-phone">Телефон <span class="req">*</span></label>
              <input id="single-phone" name="phone" required placeholder="+7 (___) ___-__-__" inputmode="tel" autocomplete="tel" aria-describedby="single-phone-error" data-phone-mask />
              <span class="field-error" id="single-phone-error" aria-live="polite"></span>
            </div>
            <div>
              <label for="single-email">Email</label>
              <input id="single-email" name="email" type="email" placeholder="name@example.com" autocomplete="email" />
            </div>
            <div>
              <label for="order-service">Услуга</label>
              <input id="order-service" name="service" value="<%= service.title %>" readonly />
            </div>
            <div>
              <label for="single-message">Комментарий</label>
              <textarea id="single-message" name="message" placeholder="Количество, формат, пожелания" maxlength="3000"></textarea>
              <small class="form-hint"><span data-char-count>0</span>/3000</small>
            </div>
            <button type="submit" class="btn btn-primary btn-block">Отправить заявку</button>
            <p class="form-hint">
              Нажимая «Отправить», вы соглашаетесь с
              <a href="/privacy">политикой конфиденциальности</a>.
            </p>
            <div data-form-status aria-live="polite"></div>
          </div>
        </form>
      </div>
    </div>
  </section>
</main>

<%- include('./partials/footer') %>
