<%- include('./partials/header', { activePage: 'services', title: service.title, description: service.description }) %>

<main id="main">
  <section class="page-hero">
    <div class="container">
      <nav class="breadcrumbs" aria-label="Хлебные крошки">
        <a href="/">Главная</a>
        <i class="fa-solid fa-chevron-right"></i>
        <a href="/services">Услуги</a>
        <i class="fa-solid fa-chevron-right"></i>
        <span><%= service.title %></span>
      </nav>
      <h1><%= service.title %></h1>
      <div class="meta-row" style="margin-top: 12px;">
        <span class="price-tag"><%= service.price %> ₽</span>
        <span class="price-unit">/ <%= service.priceUnit %></span>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container contact-grid">
      <div class="card reveal">
        <div class="service-media" style="border-radius: var(--radius-md);">
          <img src="<%= service.image || '/gallery-placeholders/service-default.svg' %>" alt="<%= service.title %>" />
          <span class="service-icon"><i class="fa <%= service.icon || 'fa-print' %>"></i></span>
        </div>
        <p class="text-muted"><%= service.description %></p>
        <ul class="contact-list">
          <li>
            <i class="fa-solid fa-clock"></i>
            <div>
              <strong>Сроки</strong>
              <span>Быстро — от 15 минут после подтверждения заказа</span>
            </div>
          </li>
          <li>
            <i class="fa-solid fa-circle-check"></i>
            <div>
              <strong>Контроль качества</strong>
              <span>Проверяем каждый отпечаток перед выдачей</span>
            </div>
          </li>
          <li>
            <i class="fa-solid fa-shield-halved"></i>
            <div>
              <strong>Оплата</strong>
              <span>Наличные, карта и безналичный расчёт для компаний</span>
            </div>
          </li>
        </ul>
      </div>

      <div class="card reveal" style="position: sticky; top: calc(var(--header-height) + 20px);">
        <h3>Оставить заявку</h3>
        <p class="text-muted" style="font-size: 0.93rem;">Заполните форму — перезвоним и подтвердим детали заказа.</p>
        <form data-form="order">
          <div class="hp-field" aria-hidden="true">
            <input type="text" name="website" tabindex="-1" autocomplete="off" value="" />
          </div>
          <div class="form-grid">
            <div>
              <label for="single-name">Имя <span class="req">*</span></label>
              <input id="single-name" name="name" required placeholder="Ваше имя" />
            </div>
            <div>
              <label for="single-phone">Телефон <span class="req">*</span></label>
              <input id="single-phone" name="phone" required placeholder="+7 (___) ___-__-__" />
            </div>
            <div>
              <label for="single-email">Email</label>
              <input id="single-email" name="email" type="email" placeholder="name@example.com" />
            </div>
            <div>
              <label for="order-service">Услуга</label>
              <input id="order-service" name="service" value="<%= service.title %>" readonly />
            </div>
            <div>
              <label for="single-message">Комментарий</label>
              <textarea id="single-message" name="message" placeholder="Количество, формат, пожелания"></textarea>
            </div>
            <button type="submit" class="btn btn-primary btn-block">Отправить заявку</button>
            <p class="form-hint">
              Нажимая «Отправить», вы соглашаетесь с
              <a href="/privacy">политикой конфиденциальности</a>.
            </p>
            <div data-form-status aria-live="polite"></div>
          </div>
        </form>
      </div>
    </div>
  </section>
</main>

<%- include('./partials/footer') %>
