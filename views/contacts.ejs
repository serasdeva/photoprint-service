<%- include('./partials/header', { activePage: 'contacts', title: 'Контакты', description: 'Адрес, телефон, режим работы и форма обратной связи PhotoPrint Service.' }) %>

<main id="main">
  <section class="page-hero contact-page-hero">
    <div class="container">
      <nav class="breadcrumbs" aria-label="Хлебные крошки">
        <a href="/">Главная</a>
        <i class="fa-solid fa-chevron-right"></i>
        <span>Контакты</span>
      </nav>
      <h1>Контакты</h1>
      <p class="lead">Свяжитесь с нами удобным способом или оставьте заявку — ответим в рабочее время.</p>
    </div>
  </section>

  <section class="section contact-page-section">
    <div class="container contact-grid contact-page-grid">
      <div class="contact-stack contact-info-stack reveal">
        <div class="card contact-info-card">
          <h3>Наши данные</h3>
          <ul class="contact-list">
            <li>
              <i class="fa-solid fa-location-dot"></i>
              <div>
                <strong>Адрес</strong>
                <span><%= settings.address %></span>
              </div>
            </li>
            <li>
              <i class="fa-solid fa-phone"></i>
              <div>
                <strong>Телефон</strong>
                <span><a href="tel:<%= String(settings.phone || '').replace(/[^\d+]/g, '') %>"><%= settings.phone %></a></span>
              </div>
            </li>
            <li>
              <i class="fa-solid fa-envelope"></i>
              <div>
                <strong>Email</strong>
                <span><a href="mailto:<%= settings.email %>"><%= settings.email %></a></span>
              </div>
            </li>
            <li>
              <i class="fa-regular fa-clock"></i>
              <div>
                <strong>Режим работы</strong>
                <span><%= settings.workHours %></span>
              </div>
            </li>
          </ul>
        </div>

        <div class="card contact-map-card">
          <div class="map"><%- settings.mapEmbed || '' %></div>
        </div>
      </div>

      <div class="card contact-form-card reveal">
        <h3>Написать нам</h3>
        <p class="text-muted contact-form-copy">Заполните форму — свяжемся с вами в рабочее время.</p>
        <form data-form="order" novalidate>
          <div class="hp-field" aria-hidden="true">
            <input type="text" name="website" tabindex="-1" autocomplete="off" value="" />
          </div>
          <div class="form-grid">
            <div class="form-row">
              <div>
                <label for="contact-name">Имя <span class="req">*</span></label>
                <input id="contact-name" name="name" required placeholder="Ваше имя" autocomplete="name" aria-describedby="contact-name-error" />
                <span class="field-error" id="contact-name-error" aria-live="polite"></span>
              </div>
              <div>
                <label for="contact-phone">Телефон <span class="req">*</span></label>
                <input id="contact-phone" name="phone" required placeholder="+7 (___) ___-__-__" inputmode="tel" autocomplete="tel" aria-describedby="contact-phone-error" data-phone-mask />
                <span class="field-error" id="contact-phone-error" aria-live="polite"></span>
              </div>
            </div>

            <div>
              <label for="contact-email">Email</label>
              <input id="contact-email" name="email" type="email" placeholder="name@example.com" autocomplete="email" />
            </div>
            <div>
              <label for="order-service">Услуга</label>
              <input id="order-service" name="service" placeholder="Например: Фото A4" />
            </div>
            <div>
              <label for="contact-message">Сообщение</label>
              <textarea id="contact-message" name="message" placeholder="Опишите задачу" maxlength="3000"></textarea>
              <small class="form-hint"><span data-char-count>0</span>/3000</small>
            </div>

            <button type="submit" class="btn btn-primary btn-block">Отправить</button>
            <p class="form-hint">
              Нажимая «Отправить», вы соглашаетесь с
              <a href="/privacy">политикой конфиденциальности</a>.
            </p>
            <div data-form-status aria-live="polite"></div>
          </div>
        </form>
      </div>
    </div>
  </section>
</main>

<%- include('./partials/footer') %>
