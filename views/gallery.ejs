<%- include('./partials/header', { activePage: 'gallery', title: 'Галерея работ', description: 'Примеры выполненных работ: фотопечать, печать документов, сканирование и копирование.' }) %>

<%
  const currentQ = typeof filters !== 'undefined' && filters ? filters.q : '';
  const currentCategory = typeof filters !== 'undefined' && filters ? filters.category : '';
  // Без JS ссылки чипов и «Показать ещё» листают галерею обычными GET-запросами.
  const galleryHref = (params = {}) => {
    const search = new URLSearchParams();
    if (currentQ) search.set('q', currentQ);
    if (params.category) search.set('category', params.category);
    if (params.page && params.page > 1) search.set('page', String(params.page));
    const query = search.toString();
    return query ? `/gallery?${query}` : '/gallery';
  };
%>

<main id="main">
  <section class="page-hero gallery-page-hero">
    <div class="container">
      <nav class="breadcrumbs" aria-label="Хлебные крошки">
        <a href="/">Главная</a>
        <i class="fa-solid fa-chevron-right"></i>
        <span>Галерея</span>
      </nav>
      <h1>Галерея работ</h1>
      <p class="lead">Нажмите на работу, чтобы открыть её в полноэкранном режиме.</p>
    </div>
  </section>

  <section class="section gallery-page-section">
    <div class="container">
      <form class="services-toolbar" method="GET" action="/gallery" role="search" aria-label="Поиск по галерее">
        <label class="search-field" for="gallery-q">
          <i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i>
          <input id="gallery-q" name="q" type="search" placeholder="Поиск: фото, печать, документы" value="<%= (typeof filters !== 'undefined' && filters && filters.q) ? filters.q : '' %>" autocomplete="off" />
        </label>
        <button type="submit" class="btn btn-secondary">Найти</button>
        <% if (typeof filters !== 'undefined' && filters && filters.q) { %>
          <a href="/gallery" class="btn btn-ghost">Сбросить</a>
        <% } %>
      </form>

      <div class="filter-bar" role="group" aria-label="Фильтр по категориям">
        <a class="filter-chip<%= currentCategory ? '' : ' active' %>" href="<%= galleryHref() %>" data-filter="all"<% if (!currentCategory) { %> aria-current="page"<% } %>>Все</a>
        <% (categories || []).forEach((category) => { %>
          <a class="filter-chip<%= currentCategory === category.value ? ' active' : '' %>" href="<%= galleryHref({ category: category.value }) %>" data-filter="<%= category.value %>"<% if (currentCategory === category.value) { %> aria-current="page"<% } %>><%= category.label %></a>
        <% }) %>
      </div>

      <% if (!total) { %>
        <div class="card empty-state">
          <i class="fa-regular fa-images"></i>
          <% if (typeof filters !== 'undefined' && filters && filters.q) { %>
            <h3>Ничего не нашли по запросу “<%= filters.q %>”</h3>
            <p>Попробуйте другой запрос или посмотрите всю галерею.</p>
            <a href="/gallery" class="btn btn-secondary">Показать всё</a>
          <% } else { %>
            <h3>В галерее пока нет работ</h3>
            <p>Мы загружаем примеры — загляните позже.</p>
            <a href="/" class="btn btn-secondary">На главную</a>
          <% } %>
        </div>
      <% } else { %>
        <div
          class="gallery-grid"
          data-gallery-grid
          data-gallery-total="<%= total %>"
          data-gallery-page-size="<%= pageSize %>"
          data-gallery-page="<%= page %>"
          data-gallery-filter="<%= currentCategory || 'all' %>"
          data-gallery-q="<%= typeof filters !== 'undefined' && filters.q ? filters.q : '' %>"
        >
          <% items.forEach((item) => { %>
            <figure
              class="gallery-item reveal"
              data-gallery-item
              data-category="<%= item.category || 'general' %>"
              data-src="<%= item.url %>"
              data-mime="<%= item.type || 'image' %>"
              data-poster="<%= item.thumbnail || '' %>"
              data-title="<%= item.title %>"
              tabindex="0"
              role="button"
              aria-label="Открыть <%= item.title %>"
            >
              <% if (item.type === 'video') { %>
                <video src="<%= item.url %>" muted playsinline preload="metadata"<% if (item.thumbnail) { %> poster="<%= item.thumbnail %>"<% } %>></video>
                <span class="play-badge"><i class="fa-solid fa-play"></i></span>
              <% } else { %>
                <img src="<%= item.url %>" alt="<%= item.title %>" loading="lazy" />
              <% } %>
              <figcaption>
                <strong><%= item.title %></strong>
                <% if (item.description) { %>
                  <div class="text-muted"><%= item.description %></div>
                <% } %>
              </figcaption>
            </figure>
            <% }) %>
        </div>
        <div class="gallery-toolbar">
          <span class="gallery-status" data-gallery-status aria-live="polite"></span>
          <% if (typeof page !== 'undefined' && page < pageCount) { %>
            <a class="btn btn-secondary" data-gallery-more href="<%= galleryHref({ category: currentCategory, page: page + 1 }) %>">
              Показать ещё
            </a>
          <% } %>
        </div>
      <% } %>
    </div>
  </section>

  <div class="lightbox" id="lightbox" role="dialog" aria-modal="true" aria-label="Просмотр работы">
    <button class="lightbox-close" id="lightbox-close" type="button" aria-label="Закрыть">
      <i class="fa-solid fa-xmark"></i>
    </button>
    <button class="lightbox-btn lightbox-prev" id="lightbox-prev" type="button" aria-label="Предыдущая работа">
      <i class="fa-solid fa-chevron-left"></i>
    </button>
    <div class="lightbox-content">
      <div id="lightbox-body"></div>
      <div class="lightbox-caption">
        <span id="lightbox-caption"></span>
        <span class="lightbox-counter" id="lightbox-counter"></span>
      </div>
    </div>
    <button class="lightbox-btn lightbox-next" id="lightbox-next" type="button" aria-label="Следующая работа">
      <i class="fa-solid fa-chevron-right"></i>
    </button>
  </div>
</main>

<%- include('./partials/footer') %>
