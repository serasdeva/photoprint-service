<%
  var siteSettings = (typeof settings !== 'undefined' && settings) ? settings : {};
  var footerPhone = siteSettings.phone || '+7 (495) 555-11-22';
  var footerPhoneHref = 'tel:' + String(footerPhone).replace(/[^\d+]/g, '');
  var footerEmail = siteSettings.email || 'hello@photoprint-service.ru';
  var footerAddress = siteSettings.address || 'г. Москва, ул. Тихая, 12';
  var footerHours = siteSettings.workHours || 'Пн–Сб: 09:00–20:00';
%>
    <footer class="site-footer">
      <div class="container footer-grid">
        <div class="footer-brand">
          <a href="/" class="brand">
            <span class="brand-mark"><i class="fa-solid fa-print"></i></span>
            <span class="brand-text">Photo<span>Print</span></span>
          </a>
          <p>Печать фотографий, копирование и оформление документов для дома, офиса и бизнеса.</p>
        </div>

        <div class="footer-col">
          <h4>Навигация</h4>
          <ul>
            <li><a href="/">Главная</a></li>
            <li><a href="/services">Услуги</a></li>
            <li><a href="/gallery">Галерея</a></li>
            <li><a href="/contacts">Контакты</a></li>
          </ul>
        </div>

        <div class="footer-col">
          <h4>Контакты</h4>
          <ul>
            <li><a href="<%= footerPhoneHref %>"><%= footerPhone %></a></li>
            <li><a href="mailto:<%= footerEmail %>"><%= footerEmail %></a></li>
            <li><%= footerAddress %></li>
          </ul>
        </div>

        <div class="footer-col">
          <h4>Режим работы</h4>
          <ul>
            <li><%= footerHours %></li>
            <li class="footer-cta"><a href="/contacts" class="btn btn-secondary btn-sm">Оставить заявку</a></li>
          </ul>
        </div>
      </div>

      <div class="container footer-bottom">
        <span>© <%= currentYear %> PhotoPrint Service. Все права защищены.</span>
        <div class="footer-bottom-links">
          <a href="/privacy">Политика конфиденциальности</a>
          <span class="divider-dot" aria-hidden="true"></span>
          <a href="/sitemap.xml">Карта сайта</a>
          <% if (typeof telegramUrl !== 'undefined' && telegramUrl) { %>
            <span class="divider-dot" aria-hidden="true"></span>
            <a href="<%= telegramUrl %>" target="_blank" rel="noopener"><i class="fa-brands fa-telegram"></i> Telegram-бот</a>
          <% } %>
        </div>
        <a href="#" class="to-top" aria-label="Вернуться наверх"><i class="fa-solid fa-arrow-up"></i> Наверх</a>
      </div>
    </footer>

    <div class="sticky-cta" id="sticky-cta" hidden>
      <div class="sticky-cta-inner">
        <span class="sticky-cta-text"><i class="fa-solid fa-bolt"></i> Нужна печать сегодня?</span>
        <a href="#order-form" class="btn btn-primary btn-sm" data-sticky-order>Оставить заявку</a>
        <a class="btn btn-secondary btn-sm" href="<%= footerPhoneHref %>"><i class="fa-solid fa-phone"></i> Позвонить</a>
        <button type="button" class="sticky-cta-close" aria-label="Скрыть"><i class="fa-solid fa-xmark"></i></button>
      </div>
    </div>

    <script src="/js/theme.js"></script>
    <script src="/js/main.js"></script>
    <script src="/js/gallery.js"></script>
  </body>
</html>
