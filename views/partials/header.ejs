<%
  var siteSettings = (typeof settings !== 'undefined' && settings) ? settings : {};
  var siteName = siteSettings.siteName || 'PhotoPrint Service';
  var phoneText = siteSettings.phone || '+7 (495) 555-11-22';
  var phoneHref = 'tel:' + String(phoneText).replace(/[^\d+]/g, '');
  var metaDescription = (typeof description !== 'undefined' && description)
    ? description
    : 'Печать фотографий, копирование документов, оформление документов и набор текста — быстро и по доступной цене.';
  var ogWidth = (typeof ogImageWidth !== 'undefined') ? ogImageWidth : null;
  var ogHeight = (typeof ogImageHeight !== 'undefined') ? ogImageHeight : null;
  var ogAlt = (typeof ogImageAlt !== 'undefined' && ogImageAlt)
    ? ogImageAlt
    : siteName + ' — печать фото и документов';
%>
<!DOCTYPE html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= title || siteName %></title>
    <meta name="description" content="<%= metaDescription %>" />
    <!-- Цвет бара совпадает с фоном страницы; JS (theme.js) уточняет его под выбранную тему. -->
    <meta name="theme-color" content="#faf7f2" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#171513" />
    <link rel="canonical" href="<%= canonicalUrl %>" />
    <% if (typeof noindex !== 'undefined' && noindex) { %>
      <meta name="robots" content="noindex, follow" />
    <% } %>
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="<%= siteName %>" />
    <meta property="og:locale" content="ru_RU" />
    <meta property="og:url" content="<%= canonicalUrl %>" />
    <meta property="og:image" content="<%= ogImage %>" />
    <% if (ogWidth && ogHeight) { %>
      <meta property="og:image:width" content="<%= ogWidth %>" />
      <meta property="og:image:height" content="<%= ogHeight %>" />
    <% } %>
    <meta property="og:image:alt" content="<%= ogAlt %>" />
    <meta property="og:title" content="<%= title || siteName %>" />
    <meta property="og:description" content="<%= metaDescription %>" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="<%= title || siteName %>" />
    <meta name="twitter:description" content="<%= metaDescription %>" />
    <meta name="twitter:image" content="<%= ogImage %>" />
    <link rel="icon" href="<%= asset('/favicon.svg') %>" type="image/svg+xml" />

    <link rel="preload" href="<%= asset('/vendor/manrope/manrope-cyrillic.woff2') %>" as="font" type="font/woff2" crossorigin />
    <link rel="stylesheet" href="<%= asset('/vendor/manrope/manrope.css') %>" />
    <link rel="preload" href="<%= asset('/vendor/fontawesome/webfonts/fa-solid-900.woff2') %>" as="font" type="font/woff2" crossorigin />
    <link rel="stylesheet" href="<%= asset('/vendor/fontawesome/icons.css') %>" />

    <link rel="stylesheet" href="<%= asset('/css/tokens.css') %>" />
    <link rel="stylesheet" href="<%= asset('/css/base.css') %>" />
    <link rel="stylesheet" href="<%= asset('/css/components.css') %>" />
    <link rel="stylesheet" href="<%= asset('/css/site.css') %>" />

    <script src="<%= asset('/js/theme-boot.js') %>"></script>
  </head>
  <body class="public-site">
    <a class="skip-link" href="#main">К основному содержимому</a>

    <header class="site-header">
      <div class="container header-inner">
        <a href="/" class="brand" aria-label="PhotoPrint — на главную">
          <span class="brand-mark"><i class="fa-solid fa-print"></i></span>
          <span class="brand-text">Photo<span>Print</span></span>
        </a>

        <nav class="nav" id="site-nav" aria-label="Главная навигация">
          <a href="/" class="nav-link <%= activePage === 'home' ? 'active' : '' %>" <%- activePage === 'home' ? 'aria-current="page"' : '' %>>Главная</a>
          <a href="/services" class="nav-link <%= activePage === 'services' ? 'active' : '' %>" <%- activePage === 'services' ? 'aria-current="page"' : '' %>>Услуги</a>
          <a href="/gallery" class="nav-link <%= activePage === 'gallery' ? 'active' : '' %>" <%- activePage === 'gallery' ? 'aria-current="page"' : '' %>>Галерея</a>
          <a href="/contacts" class="nav-link <%= activePage === 'contacts' ? 'active' : '' %>" <%- activePage === 'contacts' ? 'aria-current="page"' : '' %>>Контакты</a>
        </nav>

        <div class="header-actions">
          <button class="theme-toggle" type="button" data-theme-toggle aria-label="Переключить тему" aria-pressed="false" title="Тема">
            <i class="fa-solid fa-moon"></i>
          </button>
          <a class="phone-btn" href="<%= phoneHref %>" aria-label="Позвонить <%= phoneText %>">
            <i class="fa-solid fa-phone"></i>
            <span><%= phoneText %></span>
          </a>
          <button
            class="burger"
            type="button"
            data-nav-toggle
            aria-controls="site-nav"
            aria-expanded="false"
            aria-label="Открыть меню"
          >
            <span></span><span></span><span></span>
          </button>
        </div>
      </div>
    </header>

    <%- include('./flash') %>
    <script type="application/ld+json">
      <%- JSON.stringify({
        "@context": "https://schema.org",
        "@type": "LocalBusiness",
        "name": siteName,
        "telephone": phoneText,
        "url": canonicalUrl,
        "address": { "@type": "PostalAddress", "addressLocality": "Москва", "streetAddress": siteSettings.address || "" },
        "openingHours": siteSettings.workHours || ""
      }) %>
    </script>
