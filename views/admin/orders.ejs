<%- include('./partials/start') %>
<%- include('./partials/topbar') %>

  <div class="page-header">
    <div>
      <h1>Заявки</h1>
      <p class="page-sub">Все обращения клиентов с формы сайта</p>
    </div>
  </div>

  <div class="admin-card">
    <form method="GET" action="/admin/orders" class="orders-toolbar">
      <select name="status" aria-label="Фильтр по статусу">
        <option value="" <%= !filters.status ? 'selected' : '' %>>Все статусы</option>
        <option value="new" <%= filters.status === 'new' ? 'selected' : '' %>>Новые</option>
        <option value="in_progress" <%= filters.status === 'in_progress' ? 'selected' : '' %>>В работе</option>
        <option value="done" <%= filters.status === 'done' ? 'selected' : '' %>>Выполненные</option>
      </select>
      <input type="search" name="q" value="<%= filters.q %>" placeholder="Поиск: имя, телефон, услуга…" aria-label="Поиск заявок" />
      <button type="submit" class="btn btn-secondary btn-sm">
        <i class="fa-solid fa-magnifying-glass"></i> Найти
      </button>
      <% if (filters.status || filters.q) { %>
        <a href="/admin/orders" class="btn btn-ghost btn-sm">Сбросить</a>
      <% } %>
    </form>

    <% if (!orders.length) { %>
      <div class="empty-state">
        <i class="fa-regular fa-inbox"></i>
        <h3><%= (filters.status || filters.q) ? 'Ничего не найдено' : 'Заявок пока нет' %></h3>
        <p><%= (filters.status || filters.q) ? 'Попробуйте изменить параметры поиска.' : 'Как только клиент оставит заявку на сайте, она появится здесь.' %></p>
        <% if (filters.status || filters.q) { %>
          <a href="/admin/orders" class="btn btn-secondary">Показать все заявки</a>
        <% } else { %>
          <a href="/" class="btn btn-secondary">Открыть сайт</a>
        <% } %>
      </div>
    <% } else { %>
      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th>Клиент</th>
              <th>Услуга</th>
              <th>Сообщение</th>
              <th>Дата</th>
              <th>Статус</th>
              <th>Действия</th>
            </tr>
          </thead>
          <tbody>
            <% orders.forEach((order) => { %>
              <tr>
                <td>
                  <span class="cell-title"><%= order.name %></span>
                  <span class="cell-sub"><%= order.phone %></span>
                  <% if (order.email) { %>
                    <span class="cell-sub"><%= order.email %></span>
                  <% } %>
                </td>
                <td><%= order.service || '—' %></td>
                <td><span class="truncate" title="<%= order.message || '' %>"><%= order.message || '—' %></span></td>
                <td style="white-space: nowrap;"><%= new Date(order.createdAt).toLocaleString('ru-RU', { day: '2-digit', month: '2-digit', year: 'numeric', hour: '2-digit', minute: '2-digit' }) %></td>
                <td>
                  <div class="status-cell">
                    <% if (order.status === 'new') { %>
                      <span class="badge badge-new">Новая</span>
                    <% } else if (order.status === 'in_progress') { %>
                      <span class="badge badge-progress">В работе</span>
                    <% } else { %>
                      <span class="badge badge-done">Выполнена</span>
                    <% } %>
                    <form method="POST" action="/admin/orders/<%= order.id %>/status">
                      <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                      <select name="status" aria-label="Статус заявки">
                        <option value="new" <%= order.status === 'new' ? 'selected' : '' %>>Новая</option>
                        <option value="in_progress" <%= order.status === 'in_progress' ? 'selected' : '' %>>В работе</option>
                        <option value="done" <%= order.status === 'done' ? 'selected' : '' %>>Выполнена</option>
                      </select>
                      <button type="submit" class="btn btn-secondary btn-sm">Сохранить</button>
                    </form>
                  </div>
                </td>
                <td>
                  <form method="POST" action="/admin/orders/<%= order.id %>/delete" style="display: inline;" data-confirm="Удалить заявку от «<%= order.name %>?»">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                    <button type="submit" class="btn btn-danger btn-sm">
                      <i class="fa-regular fa-trash-can"></i> Удалить
                    </button>
                  </form>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>

      <% if (pagination.totalPages > 1) { %>
        <%
          const pageLink = (targetPage) => {
            const params = new URLSearchParams();
            if (filters.status) params.set('status', filters.status);
            if (filters.q) params.set('q', filters.q);
            params.set('page', targetPage);
            return '/admin/orders?' + params.toString();
          };
        %>
        <nav class="pagination" aria-label="Пагинация заявок">
          <% if (pagination.page > 1) { %>
            <a class="btn btn-secondary btn-sm" href="<%= pageLink(pagination.page - 1) %>">
              <i class="fa-solid fa-chevron-left"></i> Назад
            </a>
          <% } %>
          <span class="pagination-status">Стр. <%= pagination.page %> из <%= pagination.totalPages %> · заявок: <%= pagination.total %></span>
          <% if (pagination.page < pagination.totalPages) { %>
            <a class="btn btn-secondary btn-sm" href="<%= pageLink(pagination.page + 1) %>">
              Вперёд <i class="fa-solid fa-chevron-right"></i>
            </a>
          <% } %>
        </nav>
      <% } %>
    <% } %>
  </div>

<%- include('./partials/end') %>
