<%- include('./partials/start') %>
<%- include('./partials/topbar') %>

  <div class="page-header">
    <div>
      <h1><%= item ? 'Редактировать элемент' : 'Новый элемент галереи' %></h1>
      <p class="page-sub"><%= item ? item.title : 'Загрузите фото или видео (MP4)' %></p>
    </div>
    <a href="/admin/gallery" class="btn btn-ghost">
      <i class="fa-solid fa-arrow-left"></i> Назад
    </a>
  </div>

  <div class="admin-card">
    <form method="POST" action="<%= item ? '/admin/gallery/' + item.id : '/admin/gallery' %>" enctype="multipart/form-data">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
      <div class="form-grid">
        <div class="form-section">
          <div class="form-section-title"><i class="fa-solid fa-align-left"></i> Основное</div>
          <div>
            <label for="g-title">Название <span class="req">*</span></label>
            <input id="g-title" name="title" value="<%= item ? item.title : '' %>" required placeholder="Например: Печать семейных фото" />
          </div>
          <div>
            <label for="g-description">Описание</label>
            <textarea id="g-description" name="description" placeholder="Краткое описание работы"><%= item ? item.description : '' %></textarea>
          </div>
        </div>

        <div class="form-section">
          <div class="form-section-title"><i class="fa-solid fa-sliders"></i> Параметры</div>
          <div class="form-row">
            <div>
              <label for="g-type">Тип</label>
              <select id="g-type" name="type">
                <option value="image" <%= item && item.type === 'image' ? 'selected' : '' %>>Фото</option>
                <option value="video" <%= item && item.type === 'video' ? 'selected' : '' %>>Видео</option>
              </select>
            </div>
            <div>
              <label for="g-category">Категория</label>
              <input id="g-category" name="category" list="category-options" value="<%= item ? item.category : 'general' %>" placeholder="photo / print / docs" />
              <datalist id="category-options">
                <% (categories || []).forEach((category) => { %>
                  <option value="<%= category.value %>"><%= category.label %></option>
                <% }) %>
              </datalist>
            </div>
          </div>
          <div>
            <label for="g-order">Порядок</label>
            <input id="g-order" type="number" name="order" value="<%= item ? item.order : 0 %>" style="max-width: 180px;" />
          </div>
        </div>

        <div class="form-section">
          <div class="form-section-title"><i class="fa-regular fa-file"></i> Файл</div>
          <div>
            <label for="g-media">Файл</label>
            <input id="g-media" type="file" name="media" accept="image/*,video/mp4" <%= item ? '' : 'required' %> />
            <div class="form-hint">JPG, PNG, WEBP или MP4, до 25 МБ.</div>
          </div>
          <% if (item && item.url) { %>
            <div class="file-preview">
              <% if (item.type === 'image') { %>
                <img src="<%= item.url %>" alt="Текущий файл" />
              <% } else { %>
                <div class="media-placeholder" style="width: 100%; max-width: 280px; aspect-ratio: 16 / 9;">
                  <i class="fa-solid fa-play"></i>
                  <span class="form-hint" style="margin: 0;"><%= item.url.split('/').pop() %></span>
                </div>
              <% } %>
              <div class="form-hint">Текущий файл. Выберите новый файл, чтобы заменить его.</div>
            </div>
            <div class="check-field">
              <input type="checkbox" id="g-remove-file" name="removeFile" value="1" />
              <label for="g-remove-file">Убрать файл</label>
            </div>
          <% } %>
        </div>

        <div class="form-section">
          <div class="form-section-title"><i class="fa-regular fa-image"></i> Обложка (для видео)</div>
          <div>
            <label for="g-poster">Постер</label>
            <input id="g-poster" type="file" name="poster" accept="image/jpeg,image/png,image/webp" />
            <div class="form-hint">JPG, PNG или WEBP, до 25 МБ. Показывается вместо видео до нажатия «Играть».</div>
          </div>
          <% if (item && item.thumbnail) { %>
            <div class="file-preview">
              <img src="<%= item.thumbnail %>" alt="Текущий постер" style="max-width: 280px;" />
              <div class="form-hint">Текущий постер.</div>
            </div>
            <div class="check-field">
              <input type="checkbox" id="g-remove-poster" name="removePoster" value="1" />
              <label for="g-remove-poster">Убрать постер</label>
            </div>
          <% } %>
        </div>

        <div class="form-actions">
          <button type="submit" class="btn btn-primary">
            <i class="fa-solid fa-check"></i> Сохранить
          </button>
          <a href="/admin/gallery" class="btn btn-secondary">Отмена</a>
        </div>
      </div>
    </form>
  </div>

<%- include('./partials/end') %>
