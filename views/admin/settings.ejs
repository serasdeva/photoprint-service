<%- include('./partials/start') %>
<%- include('./partials/topbar') %>

  <div class="page-header">
    <div>
      <h1>Настройки сайта</h1>
      <p class="page-sub">Контакты, первый экран и встроенная карта</p>
    </div>
  </div>

  <div class="admin-card">
    <form method="POST" action="/admin/settings">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
      <div class="form-grid">
        <div class="form-section">
          <div class="form-section-title"><i class="fa-regular fa-address-card"></i> Контакты и название</div>
          <div>
            <label for="s-siteName">Название сайта</label>
            <input id="s-siteName" name="siteName" value="<%= settings.siteName %>" />
          </div>
          <div class="form-row">
            <div>
              <label for="s-phone">Телефон</label>
              <input id="s-phone" name="phone" value="<%= settings.phone %>" />
            </div>
            <div>
              <label for="s-email">Email</label>
              <input id="s-email" name="email" type="email" value="<%= settings.email %>" />
            </div>
          </div>
          <div class="form-row">
            <div>
              <label for="s-address">Адрес</label>
              <input id="s-address" name="address" value="<%= settings.address %>" />
            </div>
            <div>
              <label for="s-workHours">Режим работы</label>
              <input id="s-workHours" name="workHours" value="<%= settings.workHours %>" />
            </div>
          </div>
        </div>

        <div class="form-section">
          <div class="form-section-title"><i class="fa-solid fa-heading"></i> Первый экран</div>
          <div>
            <label for="s-heroTitle">Заголовок</label>
            <input id="s-heroTitle" name="heroTitle" value="<%= settings.heroTitle %>" />
          </div>
          <div>
            <label for="s-heroSubtitle">Подзаголовок</label>
            <textarea id="s-heroSubtitle" name="heroSubtitle"><%= settings.heroSubtitle %></textarea>
          </div>
        </div>

        <div class="form-section">
          <div class="form-section-title"><i class="fa-solid fa-map-location-dot"></i> Карта</div>
          <div>
            <label for="s-mapEmbed">HTML-код карты (iframe)</label>
            <textarea id="s-mapEmbed" name="mapEmbed" rows="4"><%= settings.mapEmbed %></textarea>
            <div class="form-hint">Вставьте iframe из Google или Яндекс Карт.</div>
          </div>
        </div>

        <div class="form-actions">
          <button type="submit" class="btn btn-primary">
            <i class="fa-solid fa-check"></i> Сохранить настройки
          </button>
        </div>
      </div>
    </form>
  </div>

<%- include('./partials/end') %>
