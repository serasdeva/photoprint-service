<%- include('./partials/start') %>
<%- include('./partials/topbar') %>

  <div class="page-header">
    <div>
      <h1>Дашборд</h1>
      <p class="page-sub">Обзор активности сайта</p>
    </div>
    <a href="/admin/orders" class="btn btn-secondary">
      Все заявки <i class="fa-solid fa-arrow-right"></i>
    </a>
  </div>

  <div class="stats-grid">
    <div class="stat-card">
      <span class="stat-card-icon"><i class="fa-solid fa-layer-group"></i></span>
      <div>
        <div class="stat-card-label">Услуги</div>
        <div class="stat-card-value"><%= stats.services %></div>
      </div>
    </div>
    <div class="stat-card">
      <span class="stat-card-icon is-success"><i class="fa-regular fa-images"></i></span>
      <div>
        <div class="stat-card-label">Элементы галереи</div>
        <div class="stat-card-value"><%= stats.galleryItems %></div>
      </div>
    </div>
    <div class="stat-card">
      <span class="stat-card-icon is-warning"><i class="fa-solid fa-inbox"></i></span>
      <div>
        <div class="stat-card-label">Заявки</div>
        <div class="stat-card-value"><%= stats.orders %></div>
      </div>
    </div>
    <a href="/admin/orders?status=new" class="stat-card stat-card-link">
      <span class="stat-card-icon is-danger"><i class="fa-solid fa-bell"></i></span>
      <div>
        <div class="stat-card-label">Новые заявки</div>
        <div class="stat-card-value"><%= stats.newOrders %></div>
      </div>
      <i class="fa-solid fa-arrow-right stat-card-arrow" aria-hidden="true"></i>
    </a>
  </div>

  <div class="admin-card">
    <div class="admin-card-head">
      <div>
        <h2>Новые заявки</h2>
        <p class="page-sub">Нуждаются в ответе или подтверждении</p>
      </div>
      <a href="/admin/orders?status=new" class="btn btn-ghost btn-sm">Все новые</a>
    </div>

    <% if (!newOrders.length) { %>
      <div class="empty-state">
        <i class="fa-regular fa-circle-check"></i>
        <h3>Новых заявок нет</h3>
        <p>Новые обращения появятся здесь.</p>
      </div>
    <% } else { %>
      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th>Клиент</th>
              <th>Услуга</th>
              <th>Сообщение</th>
              <th>Дата</th>
              <th>Быстрые действия</th>
            </tr>
          </thead>
          <tbody>
            <% newOrders.forEach((order) => { %>
              <tr>
                <td data-label="Клиент">
                  <span class="cell-title"><%= order.name %></span>
                  <a class="cell-sub admin-contact-link" href="tel:<%= String(order.phone || '').replace(/[^\d+]/g, '') %>"><%= order.phone %></a>
                  <% if (order.email) { %>
                    <a class="cell-sub admin-contact-link" href="mailto:<%= order.email %>"><%= order.email %></a>
                  <% } %>
                </td>
                <td data-label="Услуга"><%= order.service || '—' %></td>
                <td data-label="Сообщение"><span class="truncate" title="<%= order.message || '' %>"><%= order.message || '—' %></span></td>
                <td data-label="Дата"><%= new Date(order.createdAt).toLocaleString('ru-RU', { day: '2-digit', month: '2-digit', year: 'numeric', hour: '2-digit', minute: '2-digit' }) %></td>
                <td data-label="Быстрые действия">
                  <form method="POST" action="/admin/orders/<%= order.id %>/status">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                    <input type="hidden" name="status" value="in_progress" />
                    <button type="submit" class="btn btn-primary btn-sm">
                      <i class="fa-solid fa-play"></i> Взять в работу
                    </button>
                  </form>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } %>
  </div>

  <div class="admin-card">
    <div class="admin-card-head">
      <h2>Последние заявки</h2>
      <a href="/admin/orders" class="btn btn-ghost btn-sm">Показать все</a>
    </div>

    <% if (!recentOrders.length) { %>
      <div class="empty-state">
        <i class="fa-regular fa-folder-open"></i>
        <h3>Заявок пока нет</h3>
        <p>Как только клиенты начнут оставлять заявки, они появятся здесь.</p>
      </div>
    <% } else { %>
      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th>Клиент</th>
              <th>Услуга</th>
              <th>Дата</th>
              <th>Статус</th>
            </tr>
          </thead>
          <tbody>
            <% recentOrders.forEach((order) => { %>
              <tr>
                <td data-label="Клиент">
                  <span class="cell-title"><%= order.name %></span>
                  <span class="cell-sub"><%= order.phone %></span>
                </td>
                <td data-label="Услуга"><%= order.service || '—' %></td>
                <td data-label="Дата"><%= new Date(order.createdAt).toLocaleString('ru-RU', { day: '2-digit', month: '2-digit', year: 'numeric', hour: '2-digit', minute: '2-digit' }) %></td>
                <td data-label="Статус">
                  <% if (order.status === 'new') { %>
                    <span class="badge badge-new"><i class="fa-solid fa-sparkles" style="font-size: 0.65rem;"></i> Новая</span>
                  <% } else if (order.status === 'in_progress') { %>
                    <span class="badge badge-progress"><i class="fa-solid fa-spinner" style="font-size: 0.65rem;"></i> В работе</span>
                  <% } else { %>
                    <span class="badge badge-done"><i class="fa-solid fa-check" style="font-size: 0.65rem;"></i> Выполнена</span>
                  <% } %>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } %>
  </div>

<%- include('./partials/end') %>
