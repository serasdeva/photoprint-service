<%- include('./partials/start') %>
<%- include('./partials/topbar') %>

  <div class="page-header">
    <div>
      <h1><%= service ? 'Редактировать услугу' : 'Новая услуга' %></h1>
      <p class="page-sub"><%= service ? service.title : 'Заполните данные новой услуги' %></p>
    </div>
    <a href="/admin/services" class="btn btn-ghost">
      <i class="fa-solid fa-arrow-left"></i> Назад
    </a>
  </div>

  <div class="admin-card">
    <form method="POST" action="<%= service ? '/admin/services/' + service.id : '/admin/services' %>" enctype="multipart/form-data">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
      <div class="form-grid">
        <div class="form-section">
          <div class="form-section-title"><i class="fa-solid fa-align-left"></i> Основное</div>
          <div>
            <label for="f-title">Название <span class="req">*</span></label>
            <input id="f-title" name="title" value="<%= service ? service.title : '' %>" required placeholder="Например: Фото 10x15" />
          </div>
          <div>
            <label for="f-slug">Slug</label>
            <input id="f-slug" name="slug" value="<%= service ? service.slug : '' %>" placeholder="автоматически из названия" />
            <div class="form-hint">Адрес страницы: /services/&lt;slug&gt;</div>
          </div>
          <div>
            <label for="f-description">Описание</label>
            <textarea id="f-description" name="description" placeholder="Кратко опишите услугу"><%= service ? service.description : '' %></textarea>
          </div>
        </div>

        <div class="form-section">
          <div class="form-section-title"><i class="fa-solid fa-ruble-sign"></i> Цена</div>
          <div class="form-row">
            <div>
              <label for="f-price">Цена, ₽</label>
              <input id="f-price" name="price" type="number" step="0.01" min="0" value="<%= service ? service.price : 0 %>" />
            </div>
            <div>
              <label for="f-price-unit">Единица</label>
              <input id="f-price-unit" name="priceUnit" value="<%= service ? service.priceUnit : 'шт' %>" placeholder="шт / лист / страница" />
            </div>
          </div>
        </div>

        <div class="form-section">
          <div class="form-section-title"><i class="fa-solid fa-sliders"></i> Параметры</div>
          <div class="form-row">
            <div>
              <label for="f-icon">Иконка (Font Awesome)</label>
              <input id="f-icon" name="icon" value="<%= service ? service.icon : 'fa-print' %>" placeholder="fa-print" />
            </div>
            <div>
              <label for="f-order">Порядок</label>
              <input id="f-order" name="order" type="number" value="<%= service ? service.order : 0 %>" />
            </div>
          </div>
          <div class="check-field">
            <input type="checkbox" id="f-active" name="isActive" <%= service && service.isActive ? 'checked' : '' %> />
            <label for="f-active">Показывать на сайте</label>
          </div>
        </div>

        <div class="form-section">
          <div class="form-section-title"><i class="fa-regular fa-image"></i> Изображение</div>
          <div>
            <label for="f-image">Файл изображения</label>
            <input id="f-image" type="file" name="image" accept="image/*" />
            <div class="form-hint">JPG, PNG или WEBP, до 5 МБ.</div>
          </div>
          <% if (service && service.image) { %>
            <div class="file-preview">
              <img src="<%= service.image %>" alt="Текущее изображение" />
              <div class="form-hint">Текущее изображение. Выберите новый файл, чтобы заменить его.</div>
            </div>
            <div class="check-field">
              <input type="checkbox" id="f-remove-image" name="removeImage" value="1" />
              <label for="f-remove-image">Убрать изображение</label>
            </div>
          <% } %>
        </div>

        <div class="form-actions">
          <button type="submit" class="btn btn-primary">
            <i class="fa-solid fa-check"></i> Сохранить
          </button>
          <a href="/admin/services" class="btn btn-secondary">Отмена</a>
        </div>
      </div>
    </form>
  </div>

<%- include('./partials/end') %>
