<%- include('./partials/start') %>
<%- include('./partials/topbar') %>

  <div class="page-header">
    <div>
      <h1>Галерея</h1>
      <p class="page-sub">Примеры работ на сайте и в разделе «Галерея»</p>
    </div>
    <a href="/admin/gallery/new" class="btn btn-primary">
      <i class="fa-solid fa-plus"></i> Добавить элемент
    </a>
  </div>

  <div class="admin-card">
    <% if (!items.length) { %>
      <div class="empty-state">
        <i class="fa-regular fa-images"></i>
        <h3>В галерее пока пусто</h3>
        <p>Добавьте первые работы — они появятся на сайте.</p>
        <a href="/admin/gallery/new" class="btn btn-primary">Добавить элемент</a>
      </div>
    <% } else { %>
      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th>Элемент</th>
              <th>Тип</th>
              <th>Категория</th>
              <th>Порядок</th>
              <th>Действия</th>
            </tr>
          </thead>
          <tbody>
            <% items.forEach((item) => { %>
              <tr>
                <td>
                  <div class="cell-with-thumb">
                    <% if (item.type === 'video') { %>
                      <span class="table-thumb media-placeholder" title="Видео без превью"><i class="fa-solid fa-play"></i></span>
                    <% } else { %>
                      <img class="table-thumb" src="<%= item.url %>" alt="" />
                    <% } %>
                    <div>
                      <span class="cell-title"><%= item.title %></span>
                      <% if (item.description) { %>
                        <span class="cell-sub truncate"><%= item.description %></span>
                      <% } %>
                    </div>
                  </div>
                </td>
                <td>
                  <% if (item.type === 'video') { %>
                    <span class="badge badge-neutral"><i class="fa-solid fa-video" style="font-size: 0.65rem;"></i> Видео</span>
                  <% } else { %>
                    <span class="badge badge-neutral"><i class="fa-regular fa-image" style="font-size: 0.65rem;"></i> Фото</span>
                  <% } %>
                </td>
                <td><%= item.category %></td>
                <td><%= item.order %></td>
                <td>
                  <div class="table-actions">
                    <a href="/admin/gallery/<%= item.id %>/edit" class="btn btn-secondary btn-sm">
                      <i class="fa-solid fa-pen"></i> Изменить
                    </a>
                    <form method="POST" action="/admin/gallery/<%= item.id %>/delete" style="display: inline;" data-confirm="Удалить «<%= item.title %>»?">
                      <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                      <button type="submit" class="btn btn-danger btn-sm">
                        <i class="fa-regular fa-trash-can"></i> Удалить
                      </button>
                    </form>
                  </div>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } %>
  </div>

<%- include('./partials/end') %>
