<%- include('./partials/start') %>
<%- include('./partials/topbar') %>

  <div class="page-header">
    <div>
      <h1>Галерея</h1>
      <p class="page-sub">Примеры работ на сайте и в разделе «Галерея»</p>
    </div>
    <a href="/admin/gallery/new" class="btn btn-primary">
      <i class="fa-solid fa-plus"></i> Добавить элемент
    </a>
  </div>

  <div class="admin-card">
    <form method="GET" action="/admin/gallery" class="admin-list-toolbar">
      <input type="search" name="q" value="<%= filters.q %>" placeholder="Поиск по названию, категории или описанию" aria-label="Поиск по галерее" />
      <button type="submit" class="btn btn-secondary btn-sm">
        <i class="fa-solid fa-magnifying-glass"></i> Найти
      </button>
      <% if (filters.q) { %>
        <a href="/admin/gallery" class="btn btn-ghost btn-sm">Сбросить</a>
      <% } %>
      <span class="admin-list-count">Элементов: <%= pagination.total %></span>
    </form>

    <% if (!items.length) { %>
      <div class="empty-state">
        <i class="fa-regular fa-images"></i>
        <h3><%= filters.q ? 'Ничего не найдено' : 'В галерее пока пусто' %></h3>
        <p><%= filters.q ? 'Измените запрос или сбросьте поиск.' : 'Добавьте первые работы — они появятся на сайте.' %></p>
        <% if (filters.q) { %>
          <a href="/admin/gallery" class="btn btn-secondary">Показать все элементы</a>
        <% } else { %>
          <a href="/admin/gallery/new" class="btn btn-primary">Добавить элемент</a>
        <% } %>
      </div>
    <% } else { %>
      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th>Элемент</th>
              <th>Тип</th>
              <th>Категория</th>
              <th>Порядок</th>
              <th>Действия</th>
            </tr>
          </thead>
          <tbody>
            <% items.forEach((item) => { %>
              <tr>
                <td>
                  <div class="cell-with-thumb">
                    <% if (item.type === 'video') { %>
                      <span class="table-thumb media-placeholder" title="Видео без превью"><i class="fa-solid fa-play"></i></span>
                    <% } else { %>
                      <img class="table-thumb" src="<%= item.url %>" alt="" />
                    <% } %>
                    <div>
                      <span class="cell-title"><%= item.title %></span>
                      <% if (item.description) { %>
                        <span class="cell-sub truncate"><%= item.description %></span>
                      <% } %>
                    </div>
                  </div>
                </td>
                <td>
                  <% if (item.type === 'video') { %>
                    <span class="badge badge-neutral"><i class="fa-solid fa-video" style="font-size: 0.65rem;"></i> Видео</span>
                  <% } else { %>
                    <span class="badge badge-neutral"><i class="fa-regular fa-image" style="font-size: 0.65rem;"></i> Фото</span>
                  <% } %>
                </td>
                <td><%= item.category %></td>
                <td><%= item.order %></td>
                <td>
                  <div class="table-actions">
                    <a href="/admin/gallery/<%= item.id %>/edit" class="btn btn-secondary btn-sm">
                      <i class="fa-solid fa-pen"></i> Изменить
                    </a>
                    <form method="POST" action="/admin/gallery/<%= item.id %>/delete" style="display: inline;" data-confirm="Удалить «<%= item.title %>»?">
                      <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                      <button type="submit" class="btn btn-danger btn-sm">
                        <i class="fa-regular fa-trash-can"></i> Удалить
                      </button>
                    </form>
                  </div>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } %>

    <% if (pagination.totalPages > 1) { %>
      <%
        const pageLink = (targetPage) => {
          const params = new URLSearchParams();
          if (filters.q) params.set('q', filters.q);
          params.set('page', targetPage);
          return '/admin/gallery?' + params.toString();
        };
      %>
      <nav class="pagination" aria-label="Пагинация галереи">
        <% if (pagination.page > 1) { %>
          <a class="btn btn-secondary btn-sm" href="<%= pageLink(pagination.page - 1) %>"><i class="fa-solid fa-chevron-left"></i> Назад</a>
        <% } %>
        <span class="pagination-status">Стр. <%= pagination.page %> из <%= pagination.totalPages %> · элементов: <%= pagination.total %></span>
        <% if (pagination.page < pagination.totalPages) { %>
          <a class="btn btn-secondary btn-sm" href="<%= pageLink(pagination.page + 1) %>">Вперёд <i class="fa-solid fa-chevron-right"></i></a>
        <% } %>
      </nav>
    <% } %>
  </div>

<%- include('./partials/end') %>
