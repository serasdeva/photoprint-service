<%- include('./partials/start') %>
<%- include('./partials/topbar') %>

  <div class="page-header">
    <div>
      <h1>Услуги</h1>
      <p class="page-sub">Управление списком услуг и ценами</p>
    </div>
    <a href="/admin/services/new" class="btn btn-primary">
      <i class="fa-solid fa-plus"></i> Добавить услугу
    </a>
  </div>

  <div class="admin-card">
    <form method="GET" action="/admin/services" class="admin-list-toolbar">
      <input type="search" name="q" value="<%= filters.q %>" placeholder="Поиск по названию, адресу или описанию" aria-label="Поиск услуг" />
      <button type="submit" class="btn btn-secondary btn-sm">
        <i class="fa-solid fa-magnifying-glass"></i> Найти
      </button>
      <% if (filters.q) { %>
        <a href="/admin/services" class="btn btn-ghost btn-sm">Сбросить</a>
      <% } %>
      <span class="admin-list-count">Услуг: <%= pagination.total %></span>
    </form>

    <% if (!services.length) { %>
      <div class="empty-state">
        <i class="fa-regular fa-folder-open"></i>
        <h3><%= filters.q ? 'Услуги не найдены' : 'Услуг пока нет' %></h3>
        <p><%= filters.q ? 'Измените запрос или сбросьте фильтр.' : 'Добавьте первую услугу, чтобы она появилась на сайте.' %></p>
        <% if (filters.q) { %>
          <a href="/admin/services" class="btn btn-secondary">Показать все услуги</a>
        <% } else { %>
          <a href="/admin/services/new" class="btn btn-primary">Добавить услугу</a>
        <% } %>
      </div>
    <% } else { %>
      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th>Услуга</th>
              <th>Цена</th>
              <th>Порядок</th>
              <th>Статус</th>
              <th>Действия</th>
            </tr>
          </thead>
          <tbody>
            <% services.forEach((service) => { %>
              <tr>
                <td data-label="Услуга">
                  <div class="cell-with-thumb">
                    <img class="table-thumb" src="<%= service.image || '/gallery-placeholders/service-default.svg' %>" alt="" />
                    <div>
                      <span class="cell-title"><%= service.title %></span>
                      <span class="cell-sub">/<%= service.slug %></span>
                    </div>
                  </div>
                </td>
                <td data-label="Цена"><span class="cell-title"><%= service.price %> ₽</span> <span class="cell-sub">/ <%= service.priceUnit %></span></td>
                <td data-label="Порядок"><%= service.order %></td>
                <td data-label="Статус">
                  <% if (service.isActive) { %>
                    <span class="badge badge-done">Активна</span>
                  <% } else { %>
                    <span class="badge badge-neutral">Скрыта</span>
                  <% } %>
                </td>
                <td data-label="Действия">
                  <div class="table-actions">
                    <a href="/admin/services/<%= service.id %>/edit" class="btn btn-secondary btn-sm">
                      <i class="fa-solid fa-pen"></i> Изменить
                    </a>
                    <form method="POST" action="/admin/services/<%= service.id %>/delete" style="display: inline;" data-confirm="Удалить услугу «<%= service.title %>»?">
                      <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                      <button type="submit" class="btn btn-danger btn-sm">
                        <i class="fa-regular fa-trash-can"></i> Удалить
                      </button>
                    </form>
                  </div>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } %>

    <% if (pagination.totalPages > 1) { %>
      <%
        const pageLink = (targetPage) => {
          const params = new URLSearchParams();
          if (filters.q) params.set('q', filters.q);
          params.set('page', targetPage);
          return '/admin/services?' + params.toString();
        };
      %>
      <nav class="pagination" aria-label="Пагинация услуг">
        <% if (pagination.page > 1) { %>
          <a class="btn btn-secondary btn-sm" href="<%= pageLink(pagination.page - 1) %>"><i class="fa-solid fa-chevron-left"></i> Назад</a>
        <% } %>
        <span class="pagination-status">Стр. <%= pagination.page %> из <%= pagination.totalPages %> · услуг: <%= pagination.total %></span>
        <% if (pagination.page < pagination.totalPages) { %>
          <a class="btn btn-secondary btn-sm" href="<%= pageLink(pagination.page + 1) %>">Вперёд <i class="fa-solid fa-chevron-right"></i></a>
        <% } %>
      </nav>
    <% } %>
  </div>

<%- include('./partials/end') %>
