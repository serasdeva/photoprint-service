<%- include('./partials/header', { activePage: 'services', title: 'Услуги', description: 'Полный список услуг: печать фотографий, копирование, оформление документов и набор текста.' }) %>

<main id="main">
  <section class="page-hero service-list-hero">
    <div class="container">
      <nav class="breadcrumbs" aria-label="Хлебные крошки">
        <a href="/">Главная</a>
        <i class="fa-solid fa-chevron-right"></i>
        <span>Услуги</span>
      </nav>
      <h1>Услуги</h1>
      <p class="lead">Прозрачные цены и понятные сроки — выберите подходящую услугу и оставьте заявку.</p>
    </div>
  </section>

  <section class="section service-list-section">
    <div class="container">
      <% if (!services.length) { %>
        <div class="card empty-state">
          <i class="fa-regular fa-folder-open"></i>
          <h3>Услуги пока не добавлены</h3>
          <p>Список услуг скоро появится — загляните позже.</p>
          <a href="/" class="btn btn-secondary">На главную</a>
        </div>
      <% } else { %>
        <div class="cards-grid">
          <% services.forEach((service) => { %>
            <article class="card service-card card-hover reveal">
              <div class="service-media">
                <img src="<%= service.image || '/gallery-placeholders/service-default.svg' %>" alt="<%= service.title %>" loading="lazy" />
                <span class="service-icon"><i class="fa <%= service.icon || 'fa-print' %>"></i></span>
              </div>
              <div class="service-body">
                <h3><a href="/services/<%= service.slug %>"><%= service.title %></a></h3>
                <p><%= service.description %></p>
                <div class="meta-row">
                  <span class="price-tag"><%= service.price %> ₽</span>
                  <span class="price-unit">/ <%= service.priceUnit %></span>
                </div>
                <div class="service-actions">
                  <a href="/services/<%= service.slug %>" class="btn btn-secondary btn-sm">Подробнее</a>
                  <a href="/contacts?service=<%= encodeURIComponent(service.title) %>" class="btn btn-primary btn-sm">Заказать</a>
                </div>
              </div>
            </article>
          <% }) %>
        </div>
      <% } %>
    </div>
  </section>

  <section class="section section-alt">
    <div class="container">
      <div class="cta-banner reveal">
        <div>
          <h2>Не нашли нужную услугу?</h2>
          <p>Позвоните или оставьте заявку — подскажем, как решить задачу, и рассчитаем стоимость.</p>
        </div>
        <a href="/contacts" class="btn btn-lg">
          Связаться с нами <i class="fa-solid fa-arrow-right"></i>
        </a>
      </div>
    </div>
  </section>
</main>

<%- include('./partials/footer') %>
