<%- include('./partials/header', { activePage: 'home', title: title || 'Фотоистории' }) %>

<main id="main">
  <section class="hero home-hero">
    <div class="container hero-grid">
      <div class="hero-copy">
        <span class="kicker"><i class="fa-solid fa-camera"></i> Фотосъёмка важных моментов</span>
        <h1><%= settings.heroTitle || 'Истории, к которым хочется возвращаться' %></h1>
        <p class="lead"><%= settings.heroSubtitle || 'Свадьбы, дни рождения, выпускные и личные съёмки — живые кадры и бережная обработка.' %></p>

        <div class="cta-row">
          <a class="btn btn-primary btn-lg" href="#order-form">
            Обсудить съёмку <i class="fa-solid fa-arrow-right"></i>
          </a>
          <a class="btn btn-secondary btn-lg" href="/gallery">Смотреть портфолио</a>
          <a class="btn btn-ghost btn-lg" href="tel:<%= String(settings.phone||'').replace(/[^\d+]/g,'') %>"><i class="fa-solid fa-phone"></i> Позвонить</a>
        </div>

        <div class="hero-highlights" aria-label="Наши направления">
          <span><i class="fa-solid fa-heart"></i> Свадьбы и love story</span>
          <span><i class="fa-solid fa-gift"></i> Праздники</span>
          <span><i class="fa-solid fa-users"></i> Портреты</span>
        </div>

        <div class="hero-stats" aria-label="Наш подход к съёмке">
          <div class="stat">
            <strong>Ваш день</strong>
            <span>внимание к важным деталям</span>
          </div>
          <div class="stat">
            <strong>Без спешки</strong>
            <span>естественные эмоции и живые кадры</span>
          </div>
          <div class="stat">
            <strong>Ваша история</strong>
            <span>съёмка под ваш характер</span>
          </div>
        </div>
        <div class="hero-trust" aria-label="Перед съёмкой">
          <span><i class="fa-solid fa-camera"></i> Подскажу с позированием и локацией</span>
          <span><i class="fa-regular fa-image"></i> Обработанные фотографии в онлайн-галерее</span>
          <span><i class="fa-solid fa-calendar"></i> Дата съёмки — по договорённости</span>
        </div>
      </div>

      <aside class="hero-art reveal" aria-label="Примеры работ">
        <div class="hero-art-frame">
          <% if (gallery.length) { %>
            <img
              src="<%= gallery[0].type === 'video' ? (gallery[0].thumbnail || '/gallery-placeholders/sample-1.svg') : gallery[0].url %>"
              alt="<%= gallery[0].title %>"
              fetchpriority="high"
              <% if (gallery[0].type !== 'video' && gallery[0].width && gallery[0].height) { %>width="<%= gallery[0].width %>" height="<%= gallery[0].height %>"<% } %>
            />
            <span class="hero-art-caption">
              <i class="fa-regular fa-images"></i>
              <span>
                <strong><%= gallery[0].title %></strong>
                <small>Момент, который останется с вами</small>
              </span>
            </span>
          <% } else { %>
            <div class="hero-art-empty">
              <i class="fa-solid fa-camera-retro"></i>
              <span>Ваши моменты — в кадре</span>
            </div>
          <% } %>
        </div>
        <div class="hero-art-note">
          <span class="hero-art-note-icon"><i class="fa-solid fa-heart"></i></span>
          <span><strong>С заботой о деталях</strong><small>От первой встречи до готовых кадров</small></span>
        </div>
      </aside>
    </div>
  </section>

  <section class="section section-alt promo-strip-wrap">
    <div class="container">
      <div class="promo-strip reveal">
        <div class="promo-strip-head">
          <span class="kicker"><i class="fa-solid fa-heart"></i> Для важных событий и простых дней</span>
          <h2>Сохраняю воспоминания о том, что важно именно вам</h2>
        </div>

        <div class="promo-grid">
          <div class="promo-item">
            <span class="promo-icon"><i class="fa-solid fa-heart"></i></span>
            <div>
              <strong>Свадьбы и love story</strong>
              <small>Репортаж, прогулка и история пары</small>
            </div>
          </div>
          <div class="promo-item">
            <span class="promo-icon"><i class="fa-solid fa-gift"></i></span>
            <div>
              <strong>Дни рождения</strong>
              <small>Эмоции, гости и важные моменты</small>
            </div>
          </div>
          <div class="promo-item">
            <span class="promo-icon"><i class="fa-solid fa-graduation-cap"></i></span>
            <div>
              <strong>Выпускные</strong>
              <small>Праздник, который бывает один раз</small>
            </div>
          </div>
          <div class="promo-item">
            <span class="promo-icon"><i class="fa-regular fa-user"></i></span>
            <div>
              <strong>Личные и семейные съёмки</strong>
              <small>Портреты, прогулки и семейные истории</small>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <div>
          <span class="kicker"><i class="fa-solid fa-star"></i> Внимание к человеку и моменту</span>
          <h2>Чтобы на фотографиях вы были собой</h2>
        </div>
        <p class="section-copy">Помогаю сохранить атмосферу события и чувствовать себя свободно перед камерой.</p>
      </div>

      <div class="feature-grid reveal">
        <article class="card feature-card">
          <div class="feature-icon"><i class="fa-solid fa-face-smile"></i></div>
          <h3>Комфортно в кадре</h3>
          <p>Подскажу, куда встать и как двигаться, но не превращу съёмку в череду натянутых поз.</p>
        </article>
        <article class="card feature-card">
          <div class="feature-icon"><i class="fa-solid fa-camera-retro"></i></div>
          <h3>Живой репортаж</h3>
          <p>Ловлю не только главные события, но и взгляды, объятия и маленькие детали дня.</p>
        </article>
        <article class="card feature-card">
          <div class="feature-icon"><i class="fa-solid fa-wand-magic-sparkles"></i></div>
          <h3>Бережная обработка</h3>
          <p>Цвет и свет подчёркивают атмосферу кадра, а не меняют вас до неузнаваемости.</p>
        </article>
      </div>
    </div>
  </section>

  <section class="section" id="home-services">
    <div class="container">
      <div class="section-head">
        <div>
          <span class="kicker"><i class="fa-solid fa-layer-group"></i> Наши услуги</span>
          <h2>Выберите свою историю</h2>
        </div>
        <p class="section-copy">Свадьбы, дни рождения, выпускные, семейные и индивидуальные фотосессии.</p>
      </div>

      <form class="services-toolbar" method="GET" action="/services" role="search" aria-label="Поиск по услугам">
        <label class="search-field" for="home-service-search">
          <i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i>
          <input id="home-service-search" name="q" data-services-search type="search" placeholder="Например: свадебная съёмка" autocomplete="off" />
        </label>
        <button type="submit" class="btn btn-secondary">Найти</button>
        <span class="gallery-status" data-services-status aria-live="polite"></span>
      </form>

      <div class="cards-grid" data-services-grid>
        <% services.forEach((service) => { %>
          <article class="card service-card card-hover reveal" data-service-card data-title="<%= service.title.toLowerCase() %>" data-desc="<%= (service.description||'').toLowerCase() %>">
            <div class="service-media">
              <img src="<%= service.image || '/gallery-placeholders/service-default.svg' %>" alt="<%= service.title %>" loading="lazy"<% if (service.width && service.height) { %> width="<%= service.width %>" height="<%= service.height %>"<% } %> />
              <span class="service-icon"><i class="fa <%= service.icon || 'fa-camera' %>"></i></span>
            </div>
            <div class="service-body">
              <h3><a href="/services/<%= service.slug %>"><%= service.title %></a></h3>
              <p><%= service.description %></p>
              <div class="meta-row">
                <span class="price-tag"><%= service.price %> ₽</span>
                <span class="price-unit">/ <%= service.priceUnit %></span>
              </div>
              <div class="service-actions">
                <a href="/services/<%= service.slug %>" class="btn btn-secondary btn-sm">Подробнее</a>
                <a href="/contacts?service=<%= encodeURIComponent(service.title) %>" class="btn btn-primary btn-sm">Заказать</a>
              </div>
            </div>
          </article>
        <% }) %>
      </div>
      <div class="empty-state card is-hidden" data-services-empty>
        <i class="fa-regular fa-face-frown"></i>
        <h3>Ничего не нашли</h3>
        <p>Попробуйте другой запрос или посмотрите все услуги.</p>
        <button type="button" class="btn btn-secondary btn-sm" data-services-reset>Сбросить поиск</button>
      </div>

      <div class="cta-row" style="justify-content: center; margin-top: 34px;">
        <a href="/services" class="btn btn-secondary">
          Все услуги <i class="fa-solid fa-arrow-right"></i>
        </a>
      </div>
    </div>
  </section>

  <section class="section home-process">
    <div class="container">
      <div class="section-head">
        <div>
          <span class="kicker"><i class="fa-solid fa-list-check"></i> Просто и понятно</span>
          <h2>Как проходит съёмка</h2>
        </div>
        <p class="section-copy">Обсудим ваши пожелания заранее, чтобы в день съёмки вы могли просто проживать момент.</p>
      </div>
      <div class="process-grid">
        <article class="process-card reveal">
          <span class="process-number">01</span>
          <div>
            <h3>Расскажите о событии</h3>
            <p>Напишите дату, место и какой результат вы хотели бы получить.</p>
          </div>
        </article>
        <article class="process-card reveal">
          <span class="process-number">02</span>
          <div>
            <h3>Спланируем съёмку</h3>
            <p>Обсудим тайминг, локации, настроение и все важные для вас детали.</p>
          </div>
        </article>
        <article class="process-card reveal">
          <span class="process-number">03</span>
          <div>
            <h3>Получите фотографии</h3>
            <p>После съёмки вы получите готовую галерею, которой удобно делиться с близкими.</p>
          </div>
        </article>
      </div>
    </div>
  </section>

  <section class="section section-alt">
    <div class="container">
      <div class="section-head">
        <div>
          <span class="kicker"><i class="fa-solid fa-heart"></i> Наш подход</span>
          <h2>Больше, чем просто красивые кадры</h2>
        </div>
        <p class="section-copy">Фотографии помогают снова почувствовать атмосферу дня — и заметить то, что в суете могло ускользнуть.</p>
      </div>
      <div class="reviews-grid">
        <article class="card review-card reveal">
          <div class="review-head"><span class="review-author">Атмосфера</span><i class="fa-solid fa-heart"></i></div>
          <p>Съёмка — не только про постановочные портреты, но и про искренние эмоции, которые складываются в историю.</p>
          <small class="text-muted">Свадьбы · семейные праздники · встречи</small>
        </article>
        <article class="card review-card reveal">
          <div class="review-head"><span class="review-author">Спокойствие</span><i class="fa-solid fa-face-smile"></i></div>
          <p>Заранее знакомимся и обсуждаем план, чтобы перед камерой было проще расслабиться и оставаться собой.</p>
          <small class="text-muted">Подготовка · бережное сопровождение</small>
        </article>
        <article class="card review-card reveal">
          <div class="review-head"><span class="review-author">Память</span><i class="fa-regular fa-image"></i></div>
          <p>Готовые фотографии собраны в онлайн-галерею — её можно сохранить и отправить родным и друзьям.</p>
          <small class="text-muted">Готовая история · удобно поделиться</small>
        </article>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <div>
          <span class="kicker"><i class="fa-solid fa-circle-question"></i> Частые вопросы</span>
          <h2>Перед съёмкой</h2>
        </div>
      </div>
      <div class="faq-list" data-faq>
        <details class="card faq-item" open>
          <summary>Что входит в стоимость съёмки?<span class="faq-icon"><i class="fa-solid fa-chevron-down"></i></span></summary>
          <p>Стоимость зависит от формата, продолжительности и места съёмки. Напишите о событии — обсудим состав пакета и назовём цену до бронирования.</p>
        </details>
        <details class="card faq-item">
          <summary>Как забронировать дату?<span class="faq-icon"><i class="fa-solid fa-chevron-down"></i></span></summary>
          <p>Оставьте заявку или позвоните. Уточним доступность даты, детали события и условия бронирования.</p>
        </details>
        <details class="card faq-item">
          <summary>Вы фотографируете за пределами города?<span class="faq-icon"><i class="fa-solid fa-chevron-down"></i></span></summary>
          <p>Возможность выезда и его стоимость обсудим при заявке — укажите место проведения съёмки.</p>
        </details>
        <details class="card faq-item">
          <summary>Когда будут готовы фотографии?<span class="faq-icon"><i class="fa-solid fa-chevron-down"></i></span></summary>
          <p>Срок зависит от объёма съёмки. Согласуем его заранее и сообщим, когда галерея будет готова.</p>
        </details>
      </div>
    </div>
  </section>

  <section class="section section-alt">
    <div class="container">
      <div class="section-head">
        <div>
          <span class="kicker"><i class="fa-regular fa-images"></i> Примеры работ</span>
          <h2>Истории в кадрах</h2>
        </div>
        <a href="/gallery" class="btn btn-secondary">
          Смотреть всю галерею <i class="fa-solid fa-arrow-right"></i>
        </a>
      </div>

      <div class="gallery-grid">
        <% gallery.forEach((item) => { %>
          <figure
            class="gallery-item reveal"
            data-gallery-item
            data-category="<%= item.category || 'general' %>"
            data-src="<%= item.url %>"
            data-mime="<%= item.type || 'image' %>"
            data-title="<%= item.title %>"
            tabindex="0"
            role="button"
            aria-label="Открыть <%= item.title %>"
          >
            <% if (item.type === 'video') { %>
              <video src="<%= item.url %>" muted playsinline preload="metadata"></video>
              <span class="play-badge"><i class="fa-solid fa-play"></i></span>
            <% } else { %>
              <img src="<%= item.url %>" alt="<%= item.title %>" loading="lazy"<% if (item.width && item.height) { %> width="<%= item.width %>" height="<%= item.height %>"<% } %> />
            <% } %>
            <figcaption>
              <strong><%= item.title %></strong>
              <% if (item.description) { %>
                <div class="text-muted"><%= item.description %></div>
              <% } %>
            </figcaption>
          </figure>
        <% }) %>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="cta-banner reveal">
        <div>
          <h2>Планируете важный день?</h2>
          <p>Расскажите, что собираетесь отметить, — вместе подберём формат съёмки.</p>
        </div>
        <a href="/contacts" class="btn btn-lg">
          Оставить заявку <i class="fa-solid fa-arrow-right"></i>
        </a>
      </div>
    </div>
  </section>

  <section class="section section-alt" id="order-form">
    <div class="container contact-grid">
      <div class="contact-stack reveal">
        <div>
          <span class="kicker"><i class="fa-regular fa-address-card"></i> Связаться с нами</span>
          <h2 style="margin-top: 14px;">Давайте знакомиться</h2>
        </div>

        <div class="card">
          <ul class="contact-list">
            <li>
              <i class="fa-solid fa-location-dot"></i>
              <div>
                <strong>Адрес</strong>
                <span><%= settings.address %></span>
              </div>
            </li>
            <li>
              <i class="fa-solid fa-phone"></i>
              <div>
                <strong>Телефон</strong>
                <span><a href="tel:<%= String(settings.phone || '').replace(/[^\d+]/g, '') %>"><%= settings.phone %></a> <button type="button" class="btn btn-ghost btn-sm" data-copy="tel:<%= String(settings.phone||'').replace(/[^\d+]/g,'') %>"><i class="fa-regular fa-copy"></i> Копировать</button></span>
              </div>
            </li>
            <li>
              <i class="fa-solid fa-envelope"></i>
              <div>
                <strong>Email</strong>
                <span><a href="mailto:<%= settings.email %>"><%= settings.email %></a></span>
              </div>
            </li>
            <li>
              <i class="fa-regular fa-clock"></i>
              <div>
                <strong>Режим работы</strong>
                <span><%= settings.workHours %></span>
              </div>
            </li>
          </ul>
        </div>
      </div>

      <div class="card reveal">
        <h3>Оставить заявку</h3>
        <p class="text-muted" style="font-size:.9rem">Ответим в рабочее время. Поля с * обязательны.</p>
        <form data-form="order" novalidate>
          <div class="hp-field" aria-hidden="true">
            <input type="text" name="website" tabindex="-1" autocomplete="off" value="" />
          </div>
          <div class="form-grid">
            <div class="form-row">
              <div>
                <label for="home-name">Имя <span class="req">*</span></label>
                <input id="home-name" name="name" required placeholder="Ваше имя" autocomplete="name" aria-describedby="home-name-error" />
                <span class="field-error" id="home-name-error" aria-live="polite"></span>
              </div>
              <div>
                <label for="home-phone">Телефон <span class="req">*</span></label>
                <input id="home-phone" name="phone" required placeholder="+7 (___) ___-__-__" inputmode="tel" autocomplete="tel" aria-describedby="home-phone-error" data-phone-mask />
                <span class="field-error" id="home-phone-error" aria-live="polite"></span>
              </div>
            </div>

            <div>
              <label for="home-email">Email</label>
              <input id="home-email" name="email" type="email" placeholder="name@example.com" autocomplete="email" />
              <span class="field-error" aria-live="polite"></span>
            </div>

            <div>
              <label for="order-service">Услуга</label>
              <input id="order-service" name="service" placeholder="Например: свадьба или семейная съёмка" list="service-suggestions" />
              <datalist id="service-suggestions">
                <% services.forEach(s=>{ %><option value="<%= s.title %>"></option><% }) %>
              </datalist>
            </div>

            <div>
              <label for="order-message">Комментарий</label>
              <textarea id="order-message" name="message" placeholder="Дата, место и ваши пожелания" maxlength="3000"></textarea>
              <small class="form-hint"><span data-char-count>0</span>/3000</small>
            </div>

            <button type="submit" class="btn btn-primary btn-block">Отправить заявку</button>
            <p class="form-hint">
              Нажимая «Отправить», вы соглашаетесь с
              <a href="/privacy">политикой конфиденциальности</a>.
            </p>
            <div data-form-status aria-live="polite"></div>
          </div>
        </form>
      </div>
    </div>
  </section>

  <div class="lightbox" id="lightbox" role="dialog" aria-modal="true" aria-label="Просмотр работы">
    <button class="lightbox-close" id="lightbox-close" type="button" aria-label="Закрыть">
      <i class="fa-solid fa-xmark"></i>
    </button>
    <button class="lightbox-btn lightbox-prev" id="lightbox-prev" type="button" aria-label="Предыдущая работа">
      <i class="fa-solid fa-chevron-left"></i>
    </button>
    <div class="lightbox-content">
      <div id="lightbox-body"></div>
      <div class="lightbox-caption">
        <span id="lightbox-caption"></span>
        <span class="lightbox-counter" id="lightbox-counter"></span>
      </div>
    </div>
    <button class="lightbox-btn lightbox-next" id="lightbox-next" type="button" aria-label="Следующая работа">
      <i class="fa-solid fa-chevron-right"></i>
    </button>
  </div>
</main>

<%- include('./partials/footer') %>
