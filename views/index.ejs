<%- include('./partials/header', { activePage: 'home', title: title || 'PhotoPrint Service' }) %>

<main id="main">
  <section class="hero home-hero">
    <div class="container hero-grid">
      <div class="hero-copy">
        <span class="kicker"><i class="fa-solid fa-print"></i> Фото и документы — в одном месте</span>
        <h1><%= settings.heroTitle || 'Печать, копирование и оформление документов' %></h1>
        <p class="lead"><%= settings.heroSubtitle || 'Работаем для дома, офиса и бизнеса.' %></p>

        <div class="cta-row">
          <a class="btn btn-primary btn-lg" href="/services">
            Выбрать услугу <i class="fa-solid fa-arrow-right"></i>
          </a>
          <a class="btn btn-secondary btn-lg" href="/contacts">Задать вопрос</a>
        </div>

        <div class="hero-highlights" aria-label="Наши направления">
          <span><i class="fa-solid fa-camera"></i> Фотопечать</span>
          <span><i class="fa-solid fa-copy"></i> Копирование</span>
          <span><i class="fa-solid fa-file-lines"></i> Документы</span>
        </div>

        <div class="hero-stats" aria-label="Показатели сервиса">
          <div class="stat">
            <strong>1500+</strong>
            <span>выполненных заказов</span>
          </div>
          <div class="stat">
            <strong>24 ч</strong>
            <span>срок изготовления</span>
          </div>
          <div class="stat">
            <strong>4.9/5</strong>
            <span>средний рейтинг</span>
          </div>
        </div>
      </div>

      <aside class="hero-art reveal" aria-label="Примеры работ">
        <div class="hero-art-frame">
          <% if (gallery.length) { %>
            <img
              src="<%= gallery[0].type === 'video' ? (gallery[0].thumbnail || '/gallery-placeholders/sample-1.svg') : gallery[0].url %>"
              alt="<%= gallery[0].title %>"
              fetchpriority="high"
            />
            <span class="hero-art-caption">
              <i class="fa-regular fa-images"></i>
              <span>
                <strong><%= gallery[0].title %></strong>
                <small>Работа нашей мастерской</small>
              </span>
            </span>
          <% } else { %>
            <div class="hero-art-empty">
              <i class="fa-solid fa-camera-retro"></i>
              <span>Ваши идеи — в печати</span>
            </div>
          <% } %>
        </div>
        <div class="hero-art-note">
          <span class="hero-art-note-icon"><i class="fa-solid fa-heart"></i></span>
          <span><strong>С заботой о деталях</strong><small>От файла до готового заказа</small></span>
        </div>
      </aside>
    </div>
  </section>

  <section class="section section-alt promo-strip-wrap">
    <div class="container">
      <div class="promo-strip reveal">
        <div class="promo-strip-head">
          <span class="kicker"><i class="fa-solid fa-shield-heart"></i> Удобный сервис для жизни и работы</span>
          <h2>Всё, что нужно для фото, копий и документов — в одном месте</h2>
        </div>

        <div class="promo-grid">
          <div class="promo-item">
            <span class="promo-icon"><i class="fa-solid fa-print"></i></span>
            <div>
              <strong>Печать по размеру</strong>
              <small>Фото, плакаты, A4, документы</small>
            </div>
          </div>
          <div class="promo-item">
            <span class="promo-icon"><i class="fa-solid fa-file-lines"></i></span>
            <div>
              <strong>Оформление документов</strong>
              <small>Бланки, заявления, распечатки</small>
            </div>
          </div>
          <div class="promo-item">
            <span class="promo-icon"><i class="fa-solid fa-copy"></i></span>
            <div>
              <strong>Копии и сканирование</strong>
              <small>Быстро и без лишних переплат</small>
            </div>
          </div>
          <div class="promo-item">
            <span class="promo-icon"><i class="fa-solid fa-clock"></i></span>
            <div>
              <strong>Сроки по задаче</strong>
              <small>Для дома, офиса и срочных заказов</small>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <div>
          <span class="kicker"><i class="fa-solid fa-shield-heart"></i> Почему выбирают нас</span>
          <h2>Работаем быстро, чётко и без лишней бюрократии</h2>
        </div>
        <p class="section-copy">Поддержим вас в решении самых простых и срочных задач — от семейных фото до официальной печати документов.</p>
      </div>

      <div class="feature-grid reveal">
        <article class="card feature-card">
          <div class="feature-icon"><i class="fa-solid fa-bolt"></i></div>
          <h3>Быстрая обработка</h3>
          <p>Оперативно оформляем заказы и подбираем оптимальный вариант по срокам и бюджету.</p>
        </article>
        <article class="card feature-card">
          <div class="feature-icon"><i class="fa-solid fa-check-circle"></i></div>
          <h3>Гарантия качества</h3>
          <p>Проверяем форматы, качество печати и итоговую подачу, чтобы результат выглядел аккуратно.</p>
        </article>
        <article class="card feature-card">
          <div class="feature-icon"><i class="fa-solid fa-headset"></i></div>
          <h3>Личный подход</h3>
          <p>Подскажем, что лучше выбрать по материалам, размеру и назначению — без лишних сложностей.</p>
        </article>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <div>
          <span class="kicker"><i class="fa-solid fa-layer-group"></i> Наши услуги</span>
          <h2>Готовы помочь с любой задачей</h2>
        </div>
        <p class="section-copy">Печать фото, копирование, сканирование и оформление документов для дома, офиса и бизнеса.</p>
      </div>

      <div class="cards-grid">
        <% services.forEach((service) => { %>
          <article class="card service-card card-hover reveal">
            <div class="service-media">
              <img src="<%= service.image || '/gallery-placeholders/service-default.svg' %>" alt="<%= service.title %>" loading="lazy" />
              <span class="service-icon"><i class="fa <%= service.icon || 'fa-print' %>"></i></span>
            </div>
            <div class="service-body">
              <h3><a href="/services/<%= service.slug %>"><%= service.title %></a></h3>
              <p><%= service.description %></p>
              <div class="meta-row">
                <span class="price-tag"><%= service.price %> ₽</span>
                <span class="price-unit">/ <%= service.priceUnit %></span>
              </div>
              <div class="service-actions">
                <a href="/services/<%= service.slug %>" class="btn btn-secondary btn-sm">Подробнее</a>
                <a href="/contacts?service=<%= encodeURIComponent(service.title) %>" class="btn btn-primary btn-sm">Заказать</a>
              </div>
            </div>
          </article>
        <% }) %>
      </div>

      <div class="cta-row" style="justify-content: center; margin-top: 34px;">
        <a href="/services" class="btn btn-secondary">
          Все услуги <i class="fa-solid fa-arrow-right"></i>
        </a>
      </div>
    </div>
  </section>

  <section class="section home-process">
    <div class="container">
      <div class="section-head">
        <div>
          <span class="kicker"><i class="fa-solid fa-list-check"></i> Просто и понятно</span>
          <h2>Как оформить заказ</h2>
        </div>
        <p class="section-copy">Выберите удобный способ — поможем разобраться с форматом и деталями.</p>
      </div>
      <div class="process-grid">
        <article class="process-card reveal">
          <span class="process-number">01</span>
          <div>
            <h3>Выберите услугу</h3>
            <p>Посмотрите направления и цены или расскажите нам, что нужно сделать.</p>
          </div>
        </article>
        <article class="process-card reveal">
          <span class="process-number">02</span>
          <div>
            <h3>Обсудим детали</h3>
            <p>Оставьте заявку на сайте или позвоните — уточним формат и пожелания.</p>
          </div>
        </article>
        <article class="process-card reveal">
          <span class="process-number">03</span>
          <div>
            <h3>Заберите заказ</h3>
            <p>Когда всё будет готово, приходите к нам в удобное время работы.</p>
          </div>
        </article>
      </div>
    </div>
  </section>

  <section class="section section-alt">
    <div class="container">
      <div class="section-head">
        <div>
          <span class="kicker"><i class="fa-regular fa-images"></i> Примеры работ</span>
          <h2>Галерея выполненных заказов</h2>
        </div>
        <a href="/gallery" class="btn btn-secondary">
          Смотреть всю галерею <i class="fa-solid fa-arrow-right"></i>
        </a>
      </div>

      <div class="gallery-grid">
        <% gallery.forEach((item) => { %>
          <figure
            class="gallery-item reveal"
            data-gallery-item
            data-category="<%= item.category || 'general' %>"
            data-src="<%= item.url %>"
            data-mime="<%= item.type || 'image' %>"
            data-title="<%= item.title %>"
            tabindex="0"
          >
            <% if (item.type === 'video') { %>
              <video src="<%= item.url %>" muted playsinline preload="metadata"></video>
              <span class="play-badge"><i class="fa-solid fa-play"></i></span>
            <% } else { %>
              <img src="<%= item.url %>" alt="<%= item.title %>" loading="lazy" />
            <% } %>
            <figcaption>
              <strong><%= item.title %></strong>
              <% if (item.description) { %>
                <div class="text-muted"><%= item.description %></div>
              <% } %>
            </figcaption>
          </figure>
        <% }) %>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="cta-banner reveal">
        <div>
          <h2>Есть задача? Мы поможем</h2>
          <p>Оставьте заявку — обсудим детали, подскажем подходящую услугу и ответим на вопросы.</p>
        </div>
        <a href="/contacts" class="btn btn-lg">
          Оставить заявку <i class="fa-solid fa-arrow-right"></i>
        </a>
      </div>
    </div>
  </section>

  <section class="section section-alt">
    <div class="container contact-grid">
      <div class="contact-stack reveal">
        <div>
          <span class="kicker"><i class="fa-regular fa-address-card"></i> Связаться с нами</span>
          <h2 style="margin-top: 14px;">Контакты</h2>
        </div>

        <div class="card">
          <ul class="contact-list">
            <li>
              <i class="fa-solid fa-location-dot"></i>
              <div>
                <strong>Адрес</strong>
                <span><%= settings.address %></span>
              </div>
            </li>
            <li>
              <i class="fa-solid fa-phone"></i>
              <div>
                <strong>Телефон</strong>
                <span><a href="tel:<%= String(settings.phone || '').replace(/[^\d+]/g, '') %>"><%= settings.phone %></a></span>
              </div>
            </li>
            <li>
              <i class="fa-solid fa-envelope"></i>
              <div>
                <strong>Email</strong>
                <span><a href="mailto:<%= settings.email %>"><%= settings.email %></a></span>
              </div>
            </li>
            <li>
              <i class="fa-regular fa-clock"></i>
              <div>
                <strong>Режим работы</strong>
                <span><%= settings.workHours %></span>
              </div>
            </li>
          </ul>
        </div>
      </div>

      <div class="card reveal">
        <h3>Оставить заявку</h3>
        <form data-form="order">
          <div class="hp-field" aria-hidden="true">
            <input type="text" name="website" tabindex="-1" autocomplete="off" value="" />
          </div>
          <div class="form-grid">
            <div class="form-row">
              <div>
                <label for="home-name">Имя <span class="req">*</span></label>
                <input id="home-name" name="name" required placeholder="Ваше имя" />
              </div>
              <div>
                <label for="home-phone">Телефон <span class="req">*</span></label>
                <input id="home-phone" name="phone" required placeholder="+7 (___) ___-__-__" />
              </div>
            </div>

            <div>
              <label for="home-email">Email</label>
              <input id="home-email" name="email" type="email" placeholder="name@example.com" />
            </div>

            <div>
              <label for="order-service">Услуга</label>
              <input id="order-service" name="service" placeholder="Например: Фото A4" />
            </div>

            <div>
              <label for="order-message">Комментарий</label>
              <textarea id="order-message" name="message" placeholder="Опишите задачу"></textarea>
            </div>

            <button type="submit" class="btn btn-primary btn-block">Отправить заявку</button>
            <p class="form-hint">
              Нажимая «Отправить», вы соглашаетесь с
              <a href="/privacy">политикой конфиденциальности</a>.
            </p>
            <div data-form-status aria-live="polite"></div>
          </div>
        </form>
      </div>
    </div>
  </section>

  <div class="lightbox" id="lightbox" role="dialog" aria-modal="true" aria-label="Просмотр работы">
    <button class="lightbox-close" id="lightbox-close" type="button" aria-label="Закрыть">
      <i class="fa-solid fa-xmark"></i>
    </button>
    <button class="lightbox-btn lightbox-prev" id="lightbox-prev" type="button" aria-label="Предыдущая работа">
      <i class="fa-solid fa-chevron-left"></i>
    </button>
    <div class="lightbox-content">
      <div id="lightbox-body"></div>
      <div class="lightbox-caption">
        <span id="lightbox-caption"></span>
        <span class="lightbox-counter" id="lightbox-counter"></span>
      </div>
    </div>
    <button class="lightbox-btn lightbox-next" id="lightbox-next" type="button" aria-label="Следующая работа">
      <i class="fa-solid fa-chevron-right"></i>
    </button>
  </div>
</main>

<%- include('./partials/footer') %>
