{
  "name": "photoprint-service",
  "version": "1.0.0",
  "description": "Website for photo printing, copying and document services",
  "main": "server.js",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24.0.0"
  },
  "scripts": {
    "build:assets": "node tools/build-assets.js",
    "prestart": "npm run build:assets",
    "start": "node server.js",
    "predev": "npm run build:assets",
    "dev": "nodemon server.js",
    "seed": "node seeds/seed.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "pretest": "npm run build:assets",
    "test": "node --test \"tests/**/*.test.js\"",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "connect-flash": "^0.1.1",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^18.0.9",
    "ejs": "^7.0.2",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.2",
    "express-session": "^1.18.0",
    "express-validator": "^7.1.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^2.5.0",
    "nodemailer": "^10.3.1",
    "sequelize": "^6.37.3",
    "sharp": "^0.35.5",
    "slugify": "^1.6.6",
    "sqlite3": "^6.0.1",
    "telegraf": "^4.16.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "nodemon": "^3.1.4",
    "prettier": "^3.9.9",
    "supertest": "^7.3.1"
  }
}
